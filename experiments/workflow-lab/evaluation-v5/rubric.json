{
  "protocol_version": "wp5-v5",
  "adjudication": {
    "blind_to_workflow": true,
    "model_may_not_self_score": true,
    "null_means_not_observed": true,
    "question_is_useful_when": "Its answer changes G, T, S, V, X, P, an evidence requirement, a stop condition, or a persistence decision.",
    "unsupported_assumption_is": "A material activation claim that is neither evidenced, explicitly owned as an assumption with a falsifier, nor accepted by the authorized user.",
    "quick_path_correct_is": "The observed route matches the task oracle and a quick result contains no user question."
  },
  "metrics": {
    "turns_before_readiness": {
      "type": "integer",
      "minimum": 0,
      "source": "transcript",
      "better": "lower, conditional on no hidden blocking unknown"
    },
    "useful_questions": {
      "type": "integer",
      "minimum": 0,
      "source": "transcript plus oracle",
      "better": "contextual; compare with total questions"
    },
    "user_visible_technical_choices": {
      "type": "integer",
      "minimum": 0,
      "source": "transcript",
      "better": "lower for novice inputs"
    },
    "unsupported_assumptions": {
      "type": "integer",
      "minimum": 0,
      "source": "final contract plus oracle",
      "better": "lower"
    },
    "post_start_contract_corrections": {
      "type": ["integer", "null"],
      "minimum": 0,
      "source": "implementation trace",
      "better": "lower"
    },
    "out_of_scope_edits": {
      "type": ["integer", "null"],
      "minimum": 0,
      "source": "implementation diff",
      "better": "lower"
    },
    "first_pass_done": {
      "type": ["boolean", "null"],
      "source": "CodeRail done report",
      "better": "higher pass percentage"
    },
    "reopened_or_post_close_defects": {
      "type": ["integer", "null"],
      "minimum": 0,
      "source": "follow-up trace",
      "better": "lower"
    },
    "promotion_reversals": {
      "type": ["integer", "null"],
      "minimum": 0,
      "source": "glossary and ADR trace",
      "better": "lower"
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0,
      "source": "model usage metadata",
      "better": "lower, conditional on quality"
    },
    "human_interruptions": {
      "type": "integer",
      "minimum": 0,
      "source": "transcript",
      "better": "lower"
    },
    "quick_path_correct": {
      "type": "boolean",
      "source": "observed route plus oracle",
      "better": "higher percentage"
    }
  },
  "adoption_thresholds": {
    "unsupported_assumptions_or_corrections_reduction_pct": 25,
    "clear_task_quick_path_accuracy_pct": 90,
    "out_of_scope_or_closeout_regression": 0,
    "promotion_reversals_less_than_workflow_b": true,
    "clear_task_interruption_increase": 0
  },
  "decision_rule": "All thresholds must pass on observed fields. Null implementation fields cannot authorize ADOPT."
}
