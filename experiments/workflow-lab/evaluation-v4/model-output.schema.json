{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WP5 v2 Subject Batch Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "responses"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "wp5-v4"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "route",
          "turns",
          "contract",
          "promotions",
          "stop_after_contract"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "route": {
            "enum": ["quick", "guided"]
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question", "scripted_answer_index", "draft_ready"],
              "properties": {
                "question": {
                  "type": ["string", "null"]
                },
                "scripted_answer_index": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "draft_ready": {
                  "type": "boolean"
                }
              }
            }
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["G", "T", "S", "V", "X", "P", "ready"],
            "properties": {
              "G": {"type": "string"},
              "T": {"type": "string"},
              "S": {"type": "string"},
              "V": {"type": "string"},
              "X": {"type": "string"},
              "P": {"type": "string"},
              "ready": {"type": "boolean"}
            }
          },
          "promotions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name", "evidence"],
              "properties": {
                "kind": {
                  "enum": ["glossary", "ADR"]
                },
                "name": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "stop_after_contract": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
