{
  "version": "wp1-v1",
  "epistemic_states": [
    "FACT",
    "ASSUMPTION",
    "DECISION",
    "UNKNOWN"
  ],
  "coordinates": [
    "G",
    "T",
    "S",
    "V",
    "X",
    "P"
  ],
  "routes": [
    "quick",
    "guided"
  ],
  "item_requirements": {
    "FACT": [
      "id",
      "state",
      "text",
      "evidence"
    ],
    "ASSUMPTION": [
      "id",
      "state",
      "text",
      "owner",
      "falsifier",
      "risk"
    ],
    "DECISION": [
      "id",
      "state",
      "text",
      "owner"
    ],
    "UNKNOWN": [
      "id",
      "state",
      "text",
      "blocking",
      "deferred"
    ]
  },
  "readiness": {
    "required_coordinates": [
      "G",
      "T",
      "S",
      "V",
      "X",
      "P"
    ],
    "rules": [
      "every required coordinate has at least one typed item",
      "no UNKNOWN item is blocking",
      "every UNKNOWN item is exactly one of blocking or deferred",
      "every FACT item cites evidence",
      "every ASSUMPTION item has an owner and falsifier",
      "every high-risk ASSUMPTION points to an X item",
      "every DECISION item has an owner",
      "V contains executable or explicit manual verification",
      "the proposed slice is reversible at a cost appropriate to its risk"
    ],
    "forbidden_fields": [
      "confidence_score",
      "entropy_score",
      "readiness_score",
      "information_gain_score"
    ]
  },
  "draft_delta": {
    "required_fields": [
      "answer",
      "changed",
      "readiness"
    ],
    "change_operations": [
      "add",
      "replace",
      "remove"
    ],
    "rule": "Only changed item references and readiness changes appear."
  },
  "promotion": {
    "glossary_required": [
      "scenario_consistent",
      "code_consistent",
      "contradiction_resolved",
      "evidence"
    ],
    "adr_required": [
      "hard_to_reverse",
      "surprising_without_context",
      "real_tradeoff",
      "evidence",
      "decision_owner"
    ]
  }
}
